# ============================================================
# RG Eats - .gitignore
# ============================================================

# ---------- Credenciais e configurações sensíveis ----------
# Senha do banco de dados
conexao/conexao.php
# Senha de app do Gmail (SMTP)
conexao/config_email.php

# Mantenha versões de exemplo (sem senhas) no repositório:
!conexao/conexao.example.php
!conexao/config_email.example.php

# Variáveis de ambiente (caso passem a ser usadas)
.env
.env.*
!.env.example

# ---------- Logs ----------
# Erros de envio de e-mail (enviar_email.php grava aqui)
email_erro.log
*.log
error_log
php_errors.log

# ---------- Uploads de usuários ----------
# Fotos de perfil enviadas pelo site (perfil.php)
Imagens/Perfis/*
!Imagens/Perfis/.gitkeep

# ---------- Dependências ----------
vendor/
node_modules/

# ---------- Editores e IDEs ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Arquivos temporários e backups ----------
*.tmp
*.bak
*.orig
*.zip
*.rar
*.7z

# ---------- Banco de dados (dumps locais com dados reais) ----------
*.sqlite
*.db
dump_*.sql
backup_*.sql
# (o Esqueleto_prototipo_basico.sql continua versionado)

# ---------- Documentos pessoais do TCC ----------
# Descomente se não quiser versionar o documento ABNT
# *.docx
